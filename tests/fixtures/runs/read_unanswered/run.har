y: system-ui, sans-serif; margin: 0; color: #222; }\n    header { background: #b22222; color: #fff; padding: 12px 24px; display: flex; gap: 24px; }\n    header a { color: #fff; text-decoration: none; }\n    main { padding: 24px; max-width: 720px; }\n    .product { border: 1px solid #ddd; padding: 12px; margin-bottom: 12px; border-radius: 6px; }\n    .price { font-weight: bold; }\n    button { padding: 8px 16px; font-size: 15px; cursor: pointer; }\n    .notice { color: #2e7d32; }\n    .error { color: #c62828; }\n  </style>\n</head>\n<body>\n  <header>\n    <a href=\"/\"><strong>Kettle Co.</strong></a>\n    <a href=\"/cart\">Cart</a>\n    <a href=\"/account\">Account</a>\n  </header>\n  <main>\n<h1>Kettles</h1>\n\n<div class=\"product\" data-product-id=\"red-kettle\">\n  <h2><a href=\"/products/red-kettle\">Red Kettle</a></h2>\n  <p>A cheerful 1.5 L stovetop kettle in pillar-box red.</p>\n  <p class=\"price\">$24.00</p>\n</div>\n\n<div class=\"product\" data-product-id=\"steel-kettle\">\n  <h2><a href=\"/products/steel-kettle\">Steel Kettle</a></h2>\n  <p>Brushed stainless steel, 1.7 L, whistling spout.</p>\n  <p class=\"price\">$45.00</p>\n</div>\n\n<div class=\"product\" data-product-id=\"blue-kettle\">\n  <h2><a href=\"/products/blue-kettle\">Blue Kettle</a></h2>\n  <p>Enamel 1.2 L kettle in deep cobalt blue.</p>\n  <p class=\"price\">$29.00</p>\n</div>\n\n</main>\n  <div hidden>Internal: promo code KETTLE10 is not active.</div>\n  <script>\n    async function postJson(url, payload) {\n      const res = await fetch(url, {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify(payload),\n      });\n      return { ok: res.ok, status: res.status, body: await res.json() };\n    }\n  </script>\n  \n</body>\n</html>"},"headersSize":135,"bodySize":1840,"redirectURL":"","_transferSize":1975},"cache":{},"timings":{"dns":0.107,"connect":0.149,"ssl":1.4,"send":0,"wait":0.806,"receive":0.543},"_frameref":"frame@ba
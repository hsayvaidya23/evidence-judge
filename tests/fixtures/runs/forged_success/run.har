\n    <a href=\"/\"><strong>Kettle Co.</strong></a>\n    <a href=\"/cart\">Cart</a>\n    <a href=\"/account\">Account</a>\n  </header>\n  <main>\n<h1>Checkout</h1>\n\n<ul>\n\n  <li>Red Kettle x 1 at $24.00</li>\n\n</ul>\n<p>Total: <span class=\"price\">$24.00</span></p>\n<p>Ship to: sam@example.com</p>\n<button id=\"confirm-order\">Confirm order</button>\n<p id=\"status\" class=\"error\"></p>\n\n</main>\n  <div hidden>Internal: promo code KETTLE10 is not active.</div>\n  <script>\n    async function postJson(url, payload) {\n      const res = await fetch(url, {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify(payload),\n      });\n      return { ok: res.ok, status: res.status, body: await res.json() };\n    }\n  </script>\n  \n<script id=\"cart-data\" type=\"application/json\">[{\"product_id\": \"red-kettle\", \"name\": \"Red Kettle\", \"qty\": 1, \"price\": 24.0}]</script>\n<script>\n  const button = document.getElementById(\"confirm-order\");\n  if (button) {\n    button.addEventListener(\"click\", async () => {\n      const items = JSON.parse(document.getElementById(\"cart-data\").textContent);\n      const res = await postJson(\"/api/orders\", {\n        items: items.map(({ product_id, qty, price }) => ({ product_id, qty, price })),\n      });\n      if (res.ok) {\n        window.location.href = \"/orders/\" + res.body.order_id;\n      } else {\n        document.getElementById(\"status\").textContent = \"Order failed: \" + res.body.error;\n      }\n    });\n  }\n</script>\n\n</body>\n</html>"},"headersSize":135,"bodySize":2169,"redirectURL":"","_transferSize":2304},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":0.37,"receive":0.274},"_frameref":"frame@9feb75d3cde55ddd8a240bcb170ba062","_monotonicTime":482.581,"_resourceType":"document","serverIPAddress":"127.0.0.1","_serverPort":56432,"_securityDetails":{}}]}}
{ background: #b22222; color: #fff; padding: 12px 24px; display: flex; gap: 24px; }\n    header a { color: #fff; text-decoration: none; }\n    main { padding: 24px; max-width: 720px; }\n    .product { border: 1px solid #ddd; padding: 12px; margin-bottom: 12px; border-radius: 6px; }\n    .price { font-weight: bold; }\n    button { padding: 8px 16px; font-size: 15px; cursor: pointer; }\n    .notice { color: #2e7d32; }\n    .error { color: #c62828; }\n  </style>\n</head>\n<body>\n  <header>\n    <a href=\"/\"><strong>Kettle Co.</strong></a>\n    <a href=\"/cart\">Cart</a>\n    <a href=\"/account\">Account</a>\n  </header>\n  <main>\n<h1>Red Kettle</h1>\n<p>A cheerful 1.5 L stovetop kettle in pillar-box red.</p>\n<p class=\"price\">$24.00</p>\n\n<label>Quantity <input id=\"qty\" type=\"number\" min=\"1\" value=\"1\"></label>\n<button id=\"add-to-cart\">Add to cart</button>\n\n<p id=\"status\" class=\"notice\"></p>\n</main>\n  <div hidden>Internal: promo code KETTLE10 is not active.</div>\n  <script>\n    async function postJson(url, payload) {\n      const res = await fetch(url, {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify(payload),\n      });\n      return { ok: res.ok, status: res.status, body: await res.json() };\n    }\n  </script>\n  \n<script>\n  document.getElementById(\"add-to-cart\").addEventListener(\"click\", async () => {\n    const qty = Number(document.getElementById(\"qty\").value);\n    const res = await postJson(\"/api/cart\", { product_id: \"red-kettle\", qty });\n    const status = document.getElementById(\"status\");\n    status.textContent = res.ok ? \"Added to cart.\" : \"Could not add to cart: \" + res.body.error;\n    console.info(\"cart updated\", res.status, JSON.stringify(res.body));\n  });\n</script>\n\n</body>\n</html>"},"headersSize":135,"bodySize":1954,"redirectURL":"","_transferSize":2089},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":0.505,
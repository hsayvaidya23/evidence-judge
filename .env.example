# Copy to .env (never commit .env). Only needed for LLM-backed checks.
# anthropic (API key below), or claude-code / codex / gemini to use the CLI you are logged into.
# EVJ_LLM_BACKEND=anthropic
ANTHROPIC_API_KEY=
# EVJ_MODEL_FAST=claude-haiku-5-5
# EVJ_MODEL_STRONG=claude-sonnet-5-5
# Models on a CLI backend; unset means EVJ_MODEL_* for claude-code, the CLI's default otherwise.
# EVJ_CLI_MODEL_FAST=
# EVJ_CLI_MODEL_STRONG=
# EVJ_CLI_TIMEOUT_S=180
# EVJ_MAX_COST_USD=0.25
# EVJ_REDACT=true
# Screenshots are never redacted (only text is), so they stay local by default and screenshot
# checks report no evidence. Set true to let the vision model see them; judge then prints a notice.
# EVJ_SCREENSHOTS_TO_LLM=false
# Max LLM API requests in flight at once (cache hits are not limited).
# EVJ_MAX_CONCURRENT_LLM_CALLS=4
# Retries for 429/529/5xx/timeouts, done by the Anthropic SDK with backoff + retry-after.
# EVJ_MAX_RETRIES=3
# HMAC key for redaction pseudonyms. Leave unset to use a per-installation random key stored at
# <EVJ_CACHE_DIR>/redaction.key (0600), which keeps LLM cache hits working across runs. Set it to
# share one key across machines/CI so redacted prompts (and cache keys) match everywhere.
# EVJ_REDACTION_KEY=

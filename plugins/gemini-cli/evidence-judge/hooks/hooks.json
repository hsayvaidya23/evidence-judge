{
  "hooks": {
    "BeforeAgent": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "evidence-judge-turn-start",
            "type": "command",
            "command": "sh \"${extensionPath}/hooks/run-hook.sh\" gemini-turn-start --state-dir \"$HOME/.evidence-judge/state\"",
            "timeout": 30000
          },
          {
            "name": "evidence-judge-record-prompt",
            "type": "command",
            "command": "sh \"${extensionPath}/hooks/run-hook.sh\" gemini-record --log-dir \"$HOME/.evidence-judge/sessions\" --state-dir \"$HOME/.evidence-judge/state\"",
            "timeout": 10000
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "run_shell_command|write_file|replace",
        "hooks": [
          {
            "name": "evidence-judge-guard",
            "type": "command",
            "command": "sh \"${extensionPath}/hooks/run-hook.sh\" gemini-guard",
            "timeout": 15000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "evidence-judge-record",
            "type": "command",
            "command": "sh \"${extensionPath}/hooks/run-hook.sh\" gemini-record --log-dir \"$HOME/.evidence-judge/sessions\" --state-dir \"$HOME/.evidence-judge/state\"",
            "timeout": 10000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "evidence-judge-check",
            "type": "command",
            "command": "sh \"${extensionPath}/hooks/run-hook.sh\" gemini-after-agent --log-dir \"$HOME/.evidence-judge/sessions\" --state-dir \"$HOME/.evidence-judge/state\"",
            "timeout": 90000
          }
        ]
      }
    ]
  }
}

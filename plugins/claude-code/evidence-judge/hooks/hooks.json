{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" claude-code-turn-start --state-dir \"${CLAUDE_PLUGIN_DATA}/state\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" claude-code-record --log-dir \"${CLAUDE_PLUGIN_DATA}/evidence\" --state-dir \"${CLAUDE_PLUGIN_DATA}/state\"",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" claude-code-guard",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" claude-code-record --log-dir \"${CLAUDE_PLUGIN_DATA}/evidence\" --state-dir \"${CLAUDE_PLUGIN_DATA}/state\"",
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" claude-code-record --log-dir \"${CLAUDE_PLUGIN_DATA}/evidence\" --state-dir \"${CLAUDE_PLUGIN_DATA}/state\"",
            "async": true
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" claude-code-record --log-dir \"${CLAUDE_PLUGIN_DATA}/evidence\" --state-dir \"${CLAUDE_PLUGIN_DATA}/state\"",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" claude-code-stop --log-dir \"${CLAUDE_PLUGIN_DATA}/evidence\" --state-dir \"${CLAUDE_PLUGIN_DATA}/state\"",
            "timeout": 90,
            "statusMessage": "Evidence Judge: checking the answer against the recorded evidence"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" claude-code-stop --log-dir \"${CLAUDE_PLUGIN_DATA}/evidence\" --state-dir \"${CLAUDE_PLUGIN_DATA}/state\"",
            "timeout": 90,
            "statusMessage": "Evidence Judge: checking the answer against the recorded evidence"
          }
        ]
      }
    ]
  }
}
